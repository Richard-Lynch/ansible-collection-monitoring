---
apiVersion: 1

providers:
  - name: "default"
    # NOT "General". Grafana ships a built-in General folder, and asking the file provisioner to
    # create it fails with "A folder with that name already exists" — every 10s, forever, and the
    # provisioner then aborts BEFORE loading any dashboard: dashboard files on disk and zero
    # dashboards in Grafana, with the reason buried in a repeating log line. An explicit, own-able
    # folder avoids the collision.
    folder: "{{ grafana_dashboards_folder }}"
    type: file
    # Provisioned dashboards are code: edits in the UI are overwritten on the next reload, which is
    # intended — grafana_dashboards_src is the source of truth.
    options:
      path: /etc/grafana/provisioning/dashboards/dashboards
      overwriteExisting: true
      foldersFromFilesStructure: false
