// ANSIBLE MANAGED — owner: {{ config_logs_owner }}
//
// Generated by roles/config_logs from the play that deploys this entity. Do not edit here: edits
// are overwritten on the next run and the repo becomes wrong about what is deployed.
//
// Alloy loads EVERY *.alloy file in this directory and they share ONE component namespace — files
// reference each other's components freely. Every id below is therefore prefixed with the owner
// name, so two owners cannot collide. A duplicate id fails the whole agent's config load, not just
// this file.
{% for src in config_logs_sources %}

local.file_match "{{ _cl_prefix }}_{{ src.name }}" {
  path_targets = [
{% for p in src.paths %}
    {
      __address__ = "localhost",
      __path__    = "{{ p }}",
{% if src.exclude is defined %}
      __path_exclude__ = "{{ src.exclude }}",
{% endif %}
      job         = "{{ config_logs_owner }}",
{% for k, v in (src.labels | default({})).items() %}
      {{ k }} = "{{ v }}",
{% endfor %}
    },
{% endfor %}
  ]
}

loki.source.file "{{ _cl_prefix }}_{{ src.name }}" {
  targets    = local.file_match.{{ _cl_prefix }}_{{ src.name }}.targets
  forward_to = [{{ config_logs_forward_to }}]
{% if src.tail_from_end | default(false) %}
  tail_from_end = true
{% endif %}
}
{% endfor %}
