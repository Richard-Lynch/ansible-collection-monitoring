// ANSIBLE MANAGED — the baseline log sources every host ships.
//
// Generated by roles/config_logs (entrypoint: default). Do not edit here: edits are overwritten on
// the next run and the source becomes wrong about what is deployed.
//
// service_alloy owns the AGENT and its loki.write / prometheus.remote_write sinks. This owns what
// is fed into them.
// The sinks stay there deliberately: they carry the external_labels that identify the host, and
// every component here and in the metrics files forwards to them.
{% if config_logs_system | bool %}

// --- /var/log ---------------------------------------------------------------------------------
local.file_match "systemlogs" {
  path_targets = [{
    __address__ = "localhost",
    __path__    = "/var/log/{syslog,messages,*.log}",
    job         = "systemlogs",
  }]
}

loki.source.file "systemlogs" {
  targets    = local.file_match.systemlogs.targets
  forward_to = [loki.write.default.receiver]
}
{% endif %}
{% if config_logs_journal | bool %}

// --- systemd journal --------------------------------------------------------------------------
loki.source.journal "journallogs" {
  max_age       = "{{ config_logs_journal_max_age }}"
  relabel_rules = discovery.relabel.journallogs.rules
  forward_to    = [loki.write.default.receiver]
  // NOTE: This is important to fix https://github.com/grafana/alloy/issues/924
  path          = "/var/log/journal"
}

discovery.relabel "journallogs" {
  targets = []
  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal__transport"]
    target_label  = "transport"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
  // service_name, derived from the systemd unit.
  //
  // WITHOUT THIS every journal stream inherits the COMPONENT name as its service_name
  // (`loki.source.journal.journallogs`), so every unit on every host collapses into one bucket.
  // Grafana's Logs Drilldown keys on service_name, so the entire journal would be one
  // undifferentiated service while docker logs are properly split per container.
  //
  // Anchored `(.+)\.service` so only real units match; a journal entry with no unit (kernel,
  // early boot) simply does not get the label rather than getting a wrong one.
  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "(.+)\\.service"
    target_label  = "service_name"
  }
}
// boot_id DELIBERATELY NOT A LABEL. It changes on every reboot, so as a stream label it forks a
// new Loki stream per host per boot -- unbounded growth in stream count for a value nobody
// queries by. Labels must identify the SOURCE and be long-lived. The value is still present
// in the log line's own journal fields for anyone who needs it.
// https://grafana.com/docs/loki/latest/get-started/labels/
{% endif %}
{% if config_logs_docker | bool %}

// --- container logs ---------------------------------------------------------------------------
discovery.docker "dockerlogs" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "dockerlogs" {
  targets = []
  rule {
      source_labels = ["__meta_docker_container_name"]
      regex = "/(.*)"
      target_label = "service_name"
  }
  rule {
      target_label = "instance"
      replacement  = {{ ('"' ~ config_logs_hostname_override ~ '"') if config_logs_hostname_override else "constants.hostname" }}
  }
}

loki.source.docker "default" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.dockerlogs.targets
  relabel_rules = discovery.relabel.dockerlogs.rules
  forward_to = [loki.write.docker.receiver]
}
{% endif %}
